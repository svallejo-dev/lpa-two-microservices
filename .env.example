# ---------------------------------------------------------------------------
# Configuracion local. Copiar a `.env`:  cp .env.example .env
# `make up` lo hace automaticamente si `.env` no existe.
# ---------------------------------------------------------------------------

# Puertos publicados en el host
USERS_SERVICE_PORT=8001
ORDERS_SERVICE_PORT=8002

# Base de datos del Servicio de Usuarios (privada de ese servicio)
USERS_DB_NAME=users_db
USERS_DB_USER=users_app
USERS_DB_PASSWORD=users_secret

# Base de datos del Servicio de Pedidos (privada de ese servicio)
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_app
ORDERS_DB_PASSWORD=orders_secret

# Comunicacion entre servicios (nombre DNS de la red interna de Compose)
USERS_SERVICE_URL=http://users-service:8000
USER_DIRECTORY_TIMEOUT_MS=2000

LOG_LEVEL=info
